# 数据库
DATABASE_URL="file:./dev.db"

# 应用配置
NEXT_PUBLIC_APP_NAME="求职避坑共享平台"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only OCR.space key. Keep this in .env.local or deployment secrets; never expose it to the browser.
OCR_SPACE_API_KEY=""

# Used to encrypt AI API keys stored through the admin panel. Use a long random value in production.
AI_CONFIG_ENCRYPTION_KEY=""

# 管理后台（首次登录后请修改）
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# 上传配置
UPLOAD_DIR="public/uploads"
MAX_UPLOAD_SIZE_MB=10

# OAuth website applications. Register these callback URLs with each provider:
# QQ:     https://billiejob.com/api/auth/oauth/qq/callback
# WeChat: https://billiejob.com/api/auth/oauth/wechat/callback
AUTH_BASE_URL="http://localhost:3000"
QQ_APP_ID=""
QQ_APP_SECRET=""
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
